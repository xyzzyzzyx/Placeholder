{
  "name": "ui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "typedoc": "typedoc",
    "clean": "rimraf dist",
    "lint": "ng lint --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "analyze": "source-map-explorer dist/ui/browser/*.js",
    "preanalyze": "npm run clean && ng build --source-map",
    "ncu": "npm-check-updates",
    "ncu:update": "npm-check-updates -u",
    "postinstall": "npm run clean && npm run ncu"
  },
  "private": true,
