    "@tinymce/tinymce-angular": "7.0.0",
    "@types/uuid": "9.0.7",
    "bowser": "2.11.0",
    "material-design-icons-iconfont": "6.7.0",
    "ms": "2.1.3",
    "rxjs": "7.8.1",
    "tinymce": "6.8.2",
    "tslib": "2.6.2",
    "uuid": "9.0.1",
    "zone.js": "0.14.2"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "17.0.9",
